# Signed httpOnly session cookie for `student_id` login
STUDENT_SESSION_SECRET=change-me

# Counselor workspace (separate protected route /counselor/login)
COUNSELOR_ACCESS_CODE=change-me-faculty

# Optional; falls back to STUDENT_SESSION_SECRET if unset
# COUNSELOR_SESSION_SECRET=

# Optional durable persistence for serverless deployments such as Vercel.
# If both are set, the app uses Supabase for student plans and counselor notes.
# Keep the service role key server-side only; do not expose it as NEXT_PUBLIC_*.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: where JSON data is stored for local or self-hosted demos.
# Examples:
# - Writable self-hosted volume: /var/data
# - Relative: .data
# DATA_DIR=
