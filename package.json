    "jose": "^5.6.0",
    "next": "^14.2.0",
    "postcss": "^8.4.49",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.0",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^3.4.17",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^20.11.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.57.0",
